// {{project.name}}: allocation with mimalloc through C++ modules.
import std;
import mcpplibs.mwrap.mimalloc;

int main(int argc, char** argv)
{
    const int blocks = argc > 1 ? std::atoi(argv[1]) : 100000;

    // A private heap: everything allocated in it goes when it is destroyed.
    mi_heap_t* heap = mi_heap_new();
    std::size_t bytes = 0;
    for (int i = 0; i < blocks; ++i) {
        const std::size_t size = 16 + static_cast<std::size_t>(i % 1024);
        void* p = mi_heap_malloc(heap, size);
        bytes += mi_usable_size(p);
    }
    std::println("{} blocks, {} usable bytes, in one heap", blocks, bytes);
    mi_heap_destroy(heap);

    // An aligned block.
    void* page = mi_malloc_aligned(4096, 4096);
    std::println("an aligned block at {} (4096-aligned: {})", page, reinterpret_cast<std::uintptr_t>(page) % 4096 == 0);
    mi_free(page);

    // A container whose elements are mimalloc's.
    std::vector<int, mi_stl_allocator<int>> v(blocks);
    std::iota(v.begin(), v.end(), 0);
    std::println("sum of {} ints in a mimalloc vector: {}", v.size(), std::accumulate(v.begin(), v.end(), 0LL));

    std::println("mimalloc {}", mi_version());
}
